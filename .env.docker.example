# Copiar a .env.docker (no commitear secretos reales):
#   cp .env.docker.example .env.docker
#
# DATABASE_URL en Compose se inyecta por docker-compose.yml (servicio postgres).
# Las claves opcionales abajo pueden sobreescribir o complementar.

SECRET_KEY=change-me-docker-dev-only-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_ENV=development
LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8000

# Intervalo del worker (segundos); el override de Compose puede cambiarlo
POLL_INTERVAL_SECONDS=300

# WhatsApp Meta Cloud API (opcional en local; sin token el mock se usa si APP_ENV=development)
WHATSAPP_API_URL=https://graph.facebook.com/v25.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

WERAHA_API_URL=
WERAHA_API_KEY=

WEBHOOK_SECRET_TOKEN=change-me-webhook-docker

TIENDANUBE_APP_ID=
TIENDANUBE_CLIENT_SECRET=

# Seed demo (scripts/seed_demo_data.py)
SEED_USER_EMAIL=demo@tiendademo.py
SEED_USER_PASSWORD=DemoWTA2026!
