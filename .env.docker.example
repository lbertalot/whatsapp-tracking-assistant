# Copiar a .env.docker (no commitear secretos reales):
#   cp .env.docker.example .env.docker
#
# DATABASE_URL en Compose se inyecta por docker-compose.yml (servicio postgres).

# ─── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-docker-dev-only-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8000
POLL_INTERVAL_SECONDS=60

# ─── WhatsApp Meta Cloud API ──────────────────────────────────────────────────
# Vacío = mock en APP_ENV=development
WHATSAPP_API_URL=https://graph.facebook.com/v25.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Webhook WhatsApp (Meta): para recibir statuses en local exponé HTTPS (ngrok)
META_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ALLOW_GLOBAL_FALLBACK=true

# ─── Webhook security ─────────────────────────────────────────────────────────
WEBHOOK_SECRET_TOKEN=change-me-webhook-docker

# ─── Tiendanube ───────────────────────────────────────────────────────────────
# Para OAuth en Docker, copiá valores reales desde tu .env del host.
TIENDANUBE_APP_ID=
TIENDANUBE_CLIENT_SECRET=
# TIENDANUBE_OAUTH_SCOPE=read_orders write_orders

# ─── Métricas ─────────────────────────────────────────────────────────────────
# METRICS_API_KEY=

# ─── Seed demo ────────────────────────────────────────────────────────────────
# oauth_ready (default): sin TN hasta OAuth | demo: panel con token placeholder
SEED_TN_LINK_MODE=oauth_ready
