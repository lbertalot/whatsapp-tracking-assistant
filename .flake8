[flake8]
max-line-length = 100
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    .eggs,
    *.egg,
    alembic/versions
per-file-ignores =
    tests/conftest.py:E402
    tests/test_integrations/test_seed_oauth_e2e.py:E402
    scripts/seed_demo_data.py:E402
    scripts/send_demo.py:E402
