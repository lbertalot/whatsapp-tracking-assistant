# Database
DATABASE_URL=postgresql://user:password@localhost:5432/wta_dev

# Security
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# WhatsApp Meta Cloud API
WHATSAPP_API_URL=https://graph.facebook.com/v25.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Webhook WhatsApp Cloud API (Meta): configurar en el portal del app + suscripción webhook
# Callback HTTPS: {APP_BASE_URL}/webhooks/whatsapp — ver docs/META_GO_LIVE_CHECKLIST.md
META_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# true = usar token/phone global si la tienda no tiene los suyos (dev o single-tenant). false = prod multi-merchant
WHATSAPP_ALLOW_GLOBAL_FALLBACK=true

# Weraha API
WERAHA_API_URL=
WERAHA_API_KEY=

# Webhook security
WEBHOOK_SECRET_TOKEN=change-me

# Tiendanube
TIENDANUBE_APP_ID=
TIENDANUBE_CLIENT_SECRET=
APP_BASE_URL=https://your-app.herokuapp.com

# App
APP_ENV=development
LOG_LEVEL=INFO

# Worker polling interval (seconds)
# POLL_INTERVAL_SECONDS=300
