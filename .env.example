# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/wta_dev

# ─── Security ─────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── WhatsApp Meta Cloud API ──────────────────────────────────────────────────
WHATSAPP_API_URL=https://graph.facebook.com/v25.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Webhook WhatsApp Cloud API (Meta)
# Callback HTTPS: {APP_BASE_URL}/webhooks/whatsapp — ver docs/META_GO_LIVE_CHECKLIST.md
META_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# true = usar token/phone global si la tienda no tiene los suyos (dev o single-tenant).
# false = prod multi-merchant (MS-I08).
WHATSAPP_ALLOW_GLOBAL_FALLBACK=true

# ─── Webhook security ─────────────────────────────────────────────────────────
# HMAC para POST /webhooks/orders; generar un valor aleatorio seguro
WEBHOOK_SECRET_TOKEN=change-me

# ─── Tiendanube ───────────────────────────────────────────────────────────────
TIENDANUBE_APP_ID=
TIENDANUBE_CLIENT_SECRET=
# OAuth: scopes separados por espacio. Vacío = sin parámetro scope en la URL.
# TIENDANUBE_OAUTH_SCOPE=read_orders write_orders
# Opcionales (defaults en backend/app/core/config.py):
# TIENDANUBE_AUTH_URL=https://www.tiendanube.com/apps/{app_id}/authorize
# TIENDANUBE_TOKEN_URL=https://www.tiendanube.com/apps/authorize/token
# TIENDANUBE_API_URL=https://api.tiendanube.com/v1

# ─── App ──────────────────────────────────────────────────────────────────────
APP_BASE_URL=https://your-app.herokuapp.com
APP_ENV=development
LOG_LEVEL=INFO

# Worker polling interval (seconds); default 300
# POLL_INTERVAL_SECONDS=300

# Si se define, GET /metrics exige cabecera X-Metrics-Key (recomendado en prod).
# METRICS_API_KEY=
